# Secrets / local device credentials — NEVER commit real device_id/local_key
backend/config.json

# Runtime data (favorites, schedules, history, discovery state)
backend/data/

# tinytuya writes this as a side effect of every deviceScan() call
# (used by both /rescan and the network auto-discovery feature)
backend/snapshot.json

# Python
backend/venv/
__pycache__/
*.pyc

# Logs
*.log
server.log

# OS
.DS_Store
Thumbs.db

# graphify build cache/output — the useful artifact (graph.html) is copied into
# docs/assets/network-graph.html for the Pages site; the raw working dir isn't committed
graphify-out/

# Throwaway roadmap-visualization prototype (50 variants) — explicitly local-only,
# per the prototype skill's own convention. See roadmap/prototypes/README.md.
roadmap/prototypes/
